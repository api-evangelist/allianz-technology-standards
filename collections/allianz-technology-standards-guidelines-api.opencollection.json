{
  "opencollection": "1.0.0",
  "info": {
    "name": "Allianz Technology Standards Compliance Guidelines API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://standards.allianz.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Guidelines",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Allianz Technology Standards Get Pagination Guidelines",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://standards.allianz.com/api/v1/guidelines/pagination"
          },
          "docs": "Retrieve the Allianz standard for API pagination including parameters and response headers."
        },
        {
          "info": {
            "name": "Allianz Technology Standards Get Webhook Guidelines",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://standards.allianz.com/api/v1/guidelines/webhooks"
          },
          "docs": "Retrieve Allianz webhook implementation standards including security requirements and notification types."
        }
      ]
    }
  ],
  "bundled": true
}