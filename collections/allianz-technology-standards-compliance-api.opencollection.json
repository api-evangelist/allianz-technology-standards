{
  "opencollection": "1.0.0",
  "info": {
    "name": "Allianz Technology Standards Compliance API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://standards.allianz.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Compliance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Allianz Technology Standards Check Compliance",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://standards.allianz.com/api/v1/compliance/check",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Check an OpenAPI specification against Allianz technology standards and return compliance results with violations and recommendations."
        }
      ]
    }
  ],
  "bundled": true
}